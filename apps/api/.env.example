# Copy to apps/api/.env and fill in.

# TWO ROLES, ON PURPOSE.
#
# The service runs as `aangan_app`, which is not a superuser and cannot bypass
# row-level security. That is the whole point: a superuser ignores every policy
# in migration 0005, so running the API as one turns the customer and vendor
# scoping guarantees back into "the query author remembered".
#
# Migrations, the seed, backups and the restore drill run as the owner. They
# create tables and read across everybody, which the app role deliberately
# cannot do.
#
# Migration 0005 creates `aangan_app` without a login. Once, after migrating:
#
#   ALTER ROLE aangan_app WITH LOGIN PASSWORD 'something-you-generate';
#
# Pick one:
#   Docker Compose from the repo root (docker compose up -d) — port 5433, so it
#   cannot collide with a Postgres you already have on 5432:
DATABASE_URL=postgresql://aangan_app:CHANGE_ME@localhost:5433/aangan_dev
OWNER_DATABASE_URL=postgresql://aangan:aangan_local_dev@localhost:5433/aangan_dev
#   Or your own local Postgres. Create the database first:
#     createdb aangan_dev
#   DATABASE_URL=postgresql://aangan_app:CHANGE_ME@localhost:5432/aangan_dev

PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Where the two frontends run, for cookie scope and redirect checks.
WEB_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002

# Signs session cookies. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Returns the OTP in the response instead of sending an SMS, so local
# development needs no SMS account. The server refuses to start with this on
# when NODE_ENV=production.
OTP_DEV_ECHO=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Cloudflare R2 (S3-compatible). Not needed until uploads land in M3.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
