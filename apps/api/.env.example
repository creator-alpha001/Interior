# Copy to apps/api/.env and fill in.

# TWO ROLES, ON PURPOSE.
#
# The service runs as `aangan_app`, which is not a superuser and cannot bypass
# row-level security. That is the whole point: a superuser ignores every policy
# in migration 0005, so running the API as one turns the customer and vendor
# scoping guarantees back into "the query author remembered".
#
# Migrations, the seed, backups and the restore drill run as the owner. They
# create tables and read across everybody, which the app role deliberately
# cannot do.
#
# Migration 0005 creates `aangan_app` without a login. Once, after migrating:
#
#   ALTER ROLE aangan_app WITH LOGIN PASSWORD 'something-you-generate';
#
# Pick one:
#   Docker Compose from the repo root (docker compose up -d) — port 5433, so it
#   cannot collide with a Postgres you already have on 5432:
DATABASE_URL=postgresql://aangan_app:CHANGE_ME@localhost:5433/aangan_dev
OWNER_DATABASE_URL=postgresql://aangan:aangan_local_dev@localhost:5433/aangan_dev
#   Or your own local Postgres. Create the database first:
#     createdb aangan_dev
#   DATABASE_URL=postgresql://aangan_app:CHANGE_ME@localhost:5432/aangan_dev

PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Where the two frontends run, for cookie scope and redirect checks.
WEB_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002

# Signs session cookies. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Where this API is reachable from. The mobile apps build upload URLs on it, so
# on a laptop with a phone attached this is your machine's LAN address, not
# localhost.
# PUBLIC_BASE_URL=http://192.168.1.20:4000


# ------------------------------------------------------------------
# Delivery: SMS, storage and push
# ------------------------------------------------------------------
#
# Every one of these has a working path with NO third-party account. That is
# deliberate. An SMS gateway needs DLT registration, a bucket needs a Cloudflare
# account and push needs a Firebase project — each measured in days to weeks,
# and none of them should be able to stop somebody running the platform.
#
# `auto` (the default everywhere) uses the real provider when it is configured
# and a local equivalent when it is not. The startup log says which is in use.

# Returns the OTP in the response body instead of sending an SMS, so local
# development needs no SMS account at all. The server refuses to start with this
# on when NODE_ENV=production — it turns "knows a phone number" into "can sign
# in as its owner".
OTP_DEV_ECHO=true

# auto | msg91 | console | file
#   console  writes the code to the log. An operator with server access can read
#            it during a provider outage — and server access already means
#            database access, so this grants nothing new. Never over HTTP
#   file     appends to SMS_OUTBOX_PATH. This is the manual path: during a DLT
#            gap, somebody tails that file and sends the messages by hand
SMS_DRIVER=auto
SMS_OUTBOX_PATH=.data/sms-outbox.log

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# A separate DLT registration from the OTP one, and it routinely lands later.
# Codes working while notifications do not is a normal intermediate state.
MSG91_NOTIFY_TEMPLATE_ID=
MSG91_SENDER_ID=

# auto | r2 | local
#
# `local` writes to STORAGE_LOCAL_DIR and serves the files from this API, so the
# whole upload flow — requirement photographs, stage proof, portfolio, vendor
# documents — works with no bucket.
#
# In production, `auto` REFUSES to fall back to local: silently writing customer
# photographs to a container's disk is how they vanish on the next deploy. Set
# STORAGE_DRIVER=local explicitly if a mounted volume is what you intend.
STORAGE_DRIVER=auto
STORAGE_LOCAL_DIR=.data/media
# Signs local upload URLs. Falls back to SESSION_SECRET. Required in production
# when STORAGE_DRIVER=local.
STORAGE_SIGNING_SECRET=

# Cloudflare R2 (S3-compatible).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# auto | fcm | log
#
# `log` records what would have been sent. Nothing is lost when push is off: the
# notification is still written and still goes out by SMS, it just does not buzz.
PUSH_DRIVER=auto
# The service account JSON itself, or a path to it.
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=


# ------------------------------------------------------------------
# The mobile apps
# ------------------------------------------------------------------
#
# The oldest build allowed to talk to this API. Raising it forces an upgrade,
# which is the only lever there is once a bad build is on somebody's phone.
MOBILE_MIN_BUILD=0
MOBILE_UPGRADE_MESSAGE=
