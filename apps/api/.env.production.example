# Production environment — Supabase for the database, Hostinger for the API.
#
# These are the variables to paste into Hostinger's environment settings for the
# Node.js app. Do not commit the filled-in version; it holds three passwords and
# a session secret. See HOSTING.md for the order these are set in.


# ------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------
#
# PORT 5432, NOT 6543. Supabase offers three connection strings and the wrong
# two both look right:
#
#   Direct         db.<ref>.supabase.co:5432          IPv6 only. Hostinger's
#                                                     managed Node runtime is
#                                                     IPv4, so this cannot
#                                                     resolve from there.
#   Transaction    ...pooler.supabase.com:6543        Silently breaks this app.
#   Session        ...pooler.supabase.com:5432        This one.
#
# Transaction mode hands the connection back after every transaction. This app
# reserves a connection per personal request and sets app.user_id on it, which
# is what the row-level security policies read; through a transaction pooler
# those settings are gone by the next query, and the policies treat "no actor"
# as "no restriction". Nothing errors. Row-level security just stops applying.
# pg-boss cannot run on one either. The server refuses to start on port 6543 in
# production rather than let that happen quietly.
#
# ?sslmode=require is not optional and not cosmetic — postgres.js and pg both
# default to an unencrypted connection, and this crosses the public internet.
#
# Through the pooler the username is <role>.<project-ref>, not just <role>.
# The passwords come from apps/api/supabase/bootstrap.sql, which you run once
# after migrating. Neither of these is the project's `postgres` password.

# The service. A role that CANNOT bypass row-level security — that is its
# entire purpose. Never point this at `postgres`.
DATABASE_URL=postgresql://aangan_app.PROJECT_REF:APP_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Staff. BYPASSRLS, because ops read across every customer by design.
OPS_DATABASE_URL=postgresql://aangan_ops.PROJECT_REF:OPS_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# The owner, for migrations, the seed and backups. NOT set on Hostinger — this
# one belongs in your local .env only, and is here to be named rather than used.
# Leaving it unset in production is deliberate: the running API has no business
# holding a credential that can drop tables.
# OWNER_DATABASE_URL=postgresql://postgres.PROJECT_REF:POSTGRES_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase allows far fewer connections than Railway did — the session-mode
# pooler defaults to 15 for the whole project, shared with migrations and any
# psql session. These two plus headroom must stay under that.
#
# DATABASE_POOL_MAX is also the ceiling on concurrent customer and vendor
# requests, because each one reserves a connection for its whole life. Raise the
# pooler's size in the Supabase dashboard before raising these.
#
# These were 8 and 4, which with the job queue's 2 came to 14 of the 15 — one
# spare, which is not headroom. Single requests were fine and anything
# concurrent failed with (EMAXCONNSESSION), as a 500 on a different endpoint
# each time. The server now refuses to start if the three exceed the budget
# rather than leaving it to be discovered under load.
DATABASE_POOL_MAX=5
OPS_DATABASE_POOL_MAX=2

# What the pooler accepts for the whole project. Must match the pool size in the
# Supabase dashboard, under Database -> Connection pooling.
DATABASE_POOLER_MAX_CLIENTS=15


# ------------------------------------------------------------------
# The service
# ------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# Hostinger assigns the port and passes it in. Set this only if it does not.
# PORT=4000

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Where the two frontends actually are, for cookie scope and redirect checks.
WEB_ORIGIN=https://example.com
ADMIN_ORIGIN=https://admin.example.com

# Where this API is reachable from a phone. The mobile apps build upload URLs
# on it, so it has to be the public hostname, not localhost.
PUBLIC_BASE_URL=https://api.example.com

# Whether this process also runs the scheduled jobs. One Hostinger app is one
# process, so leave this on — turning it off means nothing sends notifications,
# marks invoices overdue, or sweeps expired codes.
RUN_JOBS=true

# Grouping errors by deploy. The commit sha is ideal; anything stable will do.
RELEASE=
SENTRY_DSN=


# ------------------------------------------------------------------
# Storage — R2, and this one is load-bearing
# ------------------------------------------------------------------
#
# The server REFUSES to start in production with STORAGE_DRIVER=auto and no R2
# configured. That is not pedantry: Hostinger's application disk is replaced on
# every deploy, so `local` there means customer photographs, stage evidence and
# vendor documents disappear the next time you push — with no error and nothing
# to restore from. Set the R2 variables, or accept that loss knowingly.

STORAGE_DRIVER=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=


# ------------------------------------------------------------------
# SMS and push
# ------------------------------------------------------------------
#
# MUST be false in production. The server refuses to start otherwise: echoing
# the code turns "knows a phone number" into "can sign in as its owner".
OTP_DEV_ECHO=false

# Without msg91 the server still starts and warns — a pending DLT registration
# should not stop a deploy — but no one can receive a code, so no one can sign
# in. Fill these in before calling the deploy finished.
SMS_DRIVER=auto
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_NOTIFY_TEMPLATE_ID=
MSG91_SENDER_ID=

PUSH_DRIVER=auto
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=


# ------------------------------------------------------------------
# The mobile apps
# ------------------------------------------------------------------

MOBILE_MIN_BUILD=0
MOBILE_UPGRADE_MESSAGE=
