{
  "name": "@repo/contract",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./responses": "./src/responses.ts",
    "./openapi": "./src/openapi/generate.ts"
  },
  "sideEffects": false,
  "dependencies": {
    "@repo/types": "*",
    "zod": "^3.25.76",
