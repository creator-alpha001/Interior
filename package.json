{
  "name": "interior",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:vendor": "npm run dev --workspace=vendor",
    "build": "npm run build --workspace=web && npm run build --workspace=admin && npm run build --workspace=vendor",
    "build:web": "npm run build --workspace=web",
    "build:admin": "npm run build --workspace=admin",
    "build:vendor": "npm run build --workspace=vendor",
    "start:web": "npm run start --workspace=web",
    "start:admin": "npm run start --workspace=admin",
    "start:vendor": "npm run start --workspace=vendor",
    "typecheck": "tsc -b --pretty"
  },
  "engines": {
    "node": ">=20"
  }
}